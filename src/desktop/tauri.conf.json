{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bevy3Danimation",
  "version": "0.2.0",
  "identifier": "dev.bevy3danimation.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "bun run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bevy3Danimation",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 520,
        "transparent": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "macOSPrivateApi": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "MMD player with Jolt hair and cloth physics",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
